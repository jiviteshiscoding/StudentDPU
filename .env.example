# PROJEX Client Environment Variables (Example Template)
# Copy this file to `.env.local` for local development.
# IMPORTANT: Never commit `.env.local` or any secrets to version control.
# Only safe, public/publishable browser keys should be prefixed with VITE_.

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Publishable / Anon Key (Safe for browser use)
# Supports either VITE_SUPABASE_PUBLISHABLE_KEY or legacy VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
